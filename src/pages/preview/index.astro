---
import '../../styles/preview.css'
import { ClientRouter } from 'astro:transitions'
import Footer from '../../blocks/Footer/Footer.astro'
import Menu from '../../blocks/Menu/Menu.astro'
import type { PageType, ProjectType } from '../../types/types.ts'
import { cssHelpers, getColorValue } from './cssHelpers.ts'
import ElementSelector from './ElementSelector.astro'

const page = Astro.url.searchParams.get('page')
const project = Astro.url.searchParams.get('project')
const formData = Astro.request.method === 'POST' ? await Astro.request.formData() : null
const postedData = formData?.get('data')
const postedSettings = formData?.get('settings')
const data = typeof postedData === 'string' ? postedData : Astro.url.searchParams.get('data')
const settings = typeof postedSettings === 'string' ? postedSettings : Astro.url.searchParams.get('settings')

const parsedData: PageType | null = data ? JSON.parse(data) : null

let parsedSettings: ProjectType | null = null
try {
  parsedSettings = settings ? (JSON.parse(settings) as ProjectType) : null
} catch {
  parsedSettings = null
}

const projectColors = Array.isArray(parsedSettings?.colors) ? parsedSettings.colors : []

const pageBackgroundColor = getColorValue(parsedData?.colors?.backgroundColorKey)
const pageTextColor = getColorValue(parsedData?.colors?.textColorKey)
const pageColorDeclarations = [pageBackgroundColor ? `background-color: ${pageBackgroundColor};` : '', pageTextColor ? `color: ${pageTextColor};` : ''].filter(Boolean).join(' ')
const pageColorCss = pageColorDeclarations ? `body.preview-body { ${pageColorDeclarations} }` : ''

const cssVars = cssHelpers(projectColors)
export const prerender = false
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#FF0000" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview</title>
    {parsedSettings?.extra?.style && <style is:global set:html={parsedSettings?.extra?.style} />}
    <style is:global set:html={cssVars}></style>
    <Fragment set:html={parsedSettings?.extra?.head ?? ''} />
    <ClientRouter />
  </head>
  <body class="preview-body">
    {pageColorCss && <style is:global set:html={pageColorCss} />}
    <header>
      <Menu menu={parsedSettings?.menu} pages={parsedSettings?.pages ?? []} />
    </header>
    <main>
      <ElementSelector data={parsedData} />
    </main>
    <Footer footer={parsedSettings?.footer} />
    <!-- debug info and preview functionality -->
    <div class="debug">
      <div>
        Debug Info: <span>Page: {page}</span>
        <span>Project: {project}</span>
      </div>

      <textarea id="selectedPage" readonly class="info">{data}</textarea>
      <script is:inline>
        const currentPage = new URLSearchParams(window.location.search).get('page')
        const previousPage = sessionStorage.getItem('previewPage')
        const previousScrollY = sessionStorage.getItem('previewScrollY')

        // fetch currentPage and selectedElement from localStorage
        const selectedPage = getStorage('selectedPage')
        const selectedElement = getStorage('selectedElement')

        // color-scheme based on dark mode setting
        const newDarkMode = getStorage('darkMode')
        updateColorScheme(newDarkMode)

        if (currentPage === previousPage && previousScrollY !== null) {
          window.scrollTo(0, Number(previousScrollY))
        }

        window.addEventListener('pagehide', () => {
          sessionStorage.setItem('previewPage', currentPage ?? '')
          sessionStorage.setItem('previewScrollY', String(window.scrollY))
        })

        window.addEventListener('load', () => {
          if (selectedElement) {
            findSelectableElement(selectedElement)?.classList.add('active')
          }

          document.querySelectorAll('section[data-id], [data-items]').forEach((selectable) => {
            selectable.addEventListener('click', (event) => {
              const target = event.currentTarget
              event.stopPropagation()
              event.preventDefault()

              document.querySelectorAll('section[data-id].active, [data-items].active').forEach((active) => active.classList.remove('active'))
              target.classList.add('active')

              const itemsType = target.dataset.items
              if (itemsType === 'footer' || itemsType === 'menu') {
                saveStorage('selectedElement', {
                  id: itemsType,
                  type: itemsType,
                  title: itemsType === 'footer' ? 'Footer' : 'Menu',
                })
              } else {
                const activeElement = selectedPage?.content.find((item) => item.id === target.dataset.id)
                if (activeElement) {
                  saveStorage('selectedElement', activeElement)
                }
              }
            })
          })
        })

        function findSelectableElement(element) {
          if (element.type === 'footer' || element.type === 'menu') {
            return Array.from(document.querySelectorAll('[data-items]')).find((item) => item.dataset.items === element.type)
          }
          return Array.from(document.querySelectorAll('section[data-id]')).find((item) => item.dataset.id === String(element.id))
        }

        function saveStorage(name, data) {
          const storeDate = Date.now()
          const newData = { data, storeDate }

          return localStorage.setItem(name, JSON.stringify(newData))
        }

        function getStorage(name, validateTime = 60) {
          const timeNow = Date.now()
          const storedData = JSON.parse(localStorage.getItem(name) ?? '{}')

          if (!storedData || storedData.storeDate + validateTime * 60000 < timeNow) {
            return null
          }

          return storedData.data
        }

        // listen to changes in localStorage for selectedElement
        window.addEventListener('storage', (event) => {
          if (event.key === 'selectedElement') {
            const newSelectedElement = getStorage('selectedElement')
            if (newSelectedElement) {
              const activeElement = findSelectableElement(newSelectedElement)
              if (activeElement) {
                document.querySelectorAll('section[data-id].active, [data-items].active').forEach((item) => item.classList.remove('active'))
                activeElement.classList.add('active')
                activeElement.scrollIntoView({ behavior: 'smooth', block: 'center' })

                sessionStorage.setItem('previewScrollY', String(window.scrollY))
              }
            }
          }
          if (event.key === 'darkMode') {
            const newDarkMode = getStorage('darkMode')
            updateColorScheme(newDarkMode)
          }
        })

        function updateColorScheme(newDarkMode) {
          document.body.style.colorScheme = newDarkMode ? 'dark' : 'light'
        }
      </script>
    </div>
  </body>
</html>
