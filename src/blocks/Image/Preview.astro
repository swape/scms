---
import { sanitizeHref } from '../../previewRender/common.ts'
import type { BlockPreviewProps } from '../../types/types.ts'

interface Props extends BlockPreviewProps {}

const { data } = Astro.props

const src = data?.src ? sanitizeHref(data.src) : ''
const title = data?.title || ''
const caption = data?.caption || ''
const containerClass = data?.style?.wrapper || ''
---

<section data-id={String(data?.id ?? '')} class={`${containerClass} scms_${String(data?.id ?? '')}`.trim()}>
  {title && <h2>{title}</h2>}
  <figure>
    {src && <img src={src} alt={data?.alt || ''} loading="lazy" />}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</section>
