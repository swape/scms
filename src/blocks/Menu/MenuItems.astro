---
import type { MenuElement, PageType } from '../../types/types.ts'
import { getLinkAttrs, sanitizeHref } from '../shared/helpers.ts'

interface Props {
  items: MenuElement[]
  pages: PageType[]
  layout?: 'horizontal' | 'vertical'
}

const { items, pages, layout } = Astro.props
// Dropdowns render nested lists by recursing into this component without importing it.
const MenuItems = Astro.self
---

<ul class:list={['menu-list', layout === 'vertical' && 'menu-vertical']}>
  {items.map((item) => {
    if (item.type === 'link') {
      const { href, target, rel } = getLinkAttrs(item.link)
      return (
        <li>
          <a href={href} target={target} rel={rel}>
            {item.title}
          </a>
        </li>
      )
    }

    if (item.type === 'dropdown') {
      return (
        <li>
          <details>
            <summary>{item.title}</summary>
            <MenuItems items={item.children ?? []} pages={pages} layout={layout} />
          </details>
        </li>
      )
    }

    if (item.type === 'auto') {
      const childPages = pages.filter((page) => page.parentId === item.autoParentPageId).sort((first, second) => first.order - second.order)
      const visiblePages = item.autoMaxItems && item.autoMaxItems > 0 ? childPages.slice(0, item.autoMaxItems) : childPages
      return (
        <li class="menu-auto">
          <span>{item.title}</span>
          <ul>
            {visiblePages.map((page) => (
              <li>
                <a href={sanitizeHref(`#page-${page.id}`)}>{page.title}</a>
              </li>
            ))}
          </ul>
        </li>
      )
    }
  })}
</ul>
