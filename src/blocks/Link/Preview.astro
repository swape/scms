---
import { sanitizeHref } from '../../previewRender/common.ts'
import type { BlockPreviewProps } from '../../types/types.ts'

interface Props extends BlockPreviewProps {}

const { data } = Astro.props

const link = data?.link
const text = link?.text || data?.title || data?.content || 'Link'
const href = link?.mode === 'page' ? `#page-${link.pageId || ''}` : link?.url || '#'
const target = link?.target === '_blank' ? '_blank' : '_self'
const rel = target === '_blank' ? 'noopener noreferrer' : undefined
const containerClass = data?.style?.wrapper || ''
---

<section data-id={String(data?.id ?? '')} class={`${containerClass} scms_${String(data?.id ?? '')}`.trim()}>
  <a class={link?.asButton ? 'link-button' : 'link-inline'} href={sanitizeHref(href)} target={target} rel={rel}>
    {text}
  </a>
</section>
