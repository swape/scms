---
import './menuStyles.css'
import type { MenuElement, PageType, ProjectType } from '../../types/types.ts'
import { getColorValue } from '../shared/css.ts'
import MenuItems from './MenuItems.astro'

interface Props {
  menu?: ProjectType['menu']
  pages: PageType[]
}

const { menu, pages } = Astro.props
const backgroundColor = getColorValue(menu?.style?.backgroundColor)
const textColor = getColorValue(menu?.style?.textColor)
const menuStyle = [backgroundColor ? `--menu-background: ${backgroundColor}` : '', textColor ? `--menu-text: ${textColor}` : ''].filter(Boolean).join('; ')
const menuItems: MenuElement[] = menu?.elements ?? []
---

<header id="menu" data-items="menu" class:list={['menu-inner', { 'menu-sticky': menu?.style?.sticky }]} style={menuStyle}>
  <nav aria-label="Project menu">
    <MenuItems items={menuItems} pages={pages} layout={menu?.style?.layout} />
  </nav>
</header>
