---
import { sanitizeHref } from '../../../previewRender/common.ts'

const { data } = Astro.props

const src = data?.src ? sanitizeHref(data.src) : ''
const title = data?.title || ''
const caption = data?.caption || ''
const containerClass = data?.style?.wrapper || ''
---

<div class={`${containerClass} scms_${String(data?.id ?? '')}`.trim()}>
  {title && <h2>{title}</h2>}
  <figure>
    {src && <img src={src} alt={data?.alt || ''} loading="lazy" />}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</div>
