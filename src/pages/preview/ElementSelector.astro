---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import { getElementDefinition } from '../../components/editor/elements-list.ts'
import type { ContentType, PageType } from '../../types/types.ts'
import { getCombinedCss } from './cssHelpers.ts'

const previews = import.meta.glob<{ default: AstroComponentFactory }>('/src/blocks/*/Preview.astro', { eager: true })

interface Props {
  data: PageType | null
}

const { data }: Props = Astro.props

const content: ContentType[] = data?.content || []
const combinedCss = getCombinedCss(content || [])
---

{
  content.map((item: ContentType) => {
    const definition = getElementDefinition(item.type)
    if (definition) {
      const Preview = previews[definition.preview]?.default
      if (!Preview) {
        throw new Error(`Missing preview for block type "${item.type}": ${definition.preview}`)
      }
      return <Preview data={item} />
    }

    return <div class={`${item.style?.wrapper || ''} scms_${String(item.id)}`.trim()}>{item.type}</div>
  })
}
<style is:global set:html={combinedCss}></style>
