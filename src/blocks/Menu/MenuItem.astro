---
import type { MenuElement, PageType } from '../../types/types.ts'
import { sanitizeHref } from '../shared/helpers.ts'
import MenuItems from './MenuItems.astro'

interface Props {
  item: MenuElement
  pages: PageType[]
  layout?: 'horizontal' | 'vertical'
}

const { item, pages, layout } = Astro.props
---

{
  item.type === 'link' &&
    (() => {
      const href = item.link?.mode === 'page' ? `#page-${item.link.pageId ?? ''}` : (item.link?.url ?? '#')
      const target = item.link?.target === '_blank' ? '_blank' : '_self'
      return (
        <li>
          <a href={sanitizeHref(href)} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
            {item.link?.text || item.title}
          </a>
        </li>
      )
    })()
}

{
  item.type === 'dropdown' && (
    <li>
      <details>
        <summary>{item.title}</summary>
        <MenuItems items={item.children ?? []} pages={pages} layout={layout} />
      </details>
    </li>
  )
}

{
  item.type === 'auto' &&
    (() => {
      const childPages = pages.filter((page) => page.parentId === item.autoParentPageId).sort((first, second) => first.order - second.order)
      const visiblePages = item.autoMaxItems && item.autoMaxItems > 0 ? childPages.slice(0, item.autoMaxItems) : childPages
      return (
        <li class="menu-auto">
          <span>{item.title}</span>
          <ul>
            {visiblePages.map((page) => (
              <li>
                <a href={sanitizeHref(`#page-${page.id}`)}>{page.title}</a>
              </li>
            ))}
          </ul>
        </li>
      )
    })()
}
