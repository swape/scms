---
const { data } = Astro.props

const content = data?.content || ''
const Heading = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].includes(data?.headerLevel) ? data.headerLevel : 'h1'
const containerClass = data?.style?.wrapper || ''
---

<div class={containerClass}>
  <Heading class={`scms_${String(data?.id ?? '')}`}>{content}</Heading>
</div>
