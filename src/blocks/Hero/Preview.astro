---
import type { BlockPreviewProps } from '../../types/types.ts'
import { sanitizeHref } from '../shared/helpers.ts'
import './heroStyles.css'

interface Props extends BlockPreviewProps {}
const { data } = Astro.props
const Heading = data.headerLevel ?? 'h1'
const link = data.link
const href = link?.mode === 'page' ? `#page-${link.pageId || ''}` : link?.url || '#'
const target = link?.target === '_blank' ? '_blank' : '_self'
---

<section data-id={String(data.id)} class:list={['hero', `scms_${data.id}`, data.style?.wrapper]}>
  {data.src && <img class="hero-image" src={sanitizeHref(data.src)} alt="" />}
  {data.src && <div class="hero-overlay" aria-hidden="true"></div>}
  <div class="hero-content">
    {data.title && <Heading>{data.title}</Heading>}
    {data.content && <p>{data.content}</p>}
    {link?.text && (
      <a class="hero-button" href={sanitizeHref(href)} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
        {link.text}
      </a>
    )}
  </div>
</section>
