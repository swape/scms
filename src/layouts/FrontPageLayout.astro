---
import '../styles/global.css'
import Login from '../components/Login.svelte'

interface Props {
  title?: string
}

const { title = 'SCMS' }: Props = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#2c2c2c" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <title>{title}</title>
  </head>
  <body class="app-body">
    <nav class="app-navigation" aria-label="Main navigation">
      <div class="app-navigation-links">
        <span class="app-brand">SCMS</span>
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>
          Home
        </a>
        <a href="/dashboard" aria-current={path === '/dashboard' ? 'page' : undefined}>
          Dashboard
        </a>
      </div>

      <Login client:only="svelte" />
    </nav>
    <article class="app-content">
      <slot />
    </article>
  </body>
</html>
